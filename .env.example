# conversational-voice-agent — example environment
#
# Copy this file to `.env` in the repo root and fill in your own values:
#
#     cp .env.example .env
#     # then edit .env
#
# The voice loop runs from the repo root, and the `thelab` agent brain reads
# these via load_dotenv() + os.getenv(...). `.env` is gitignored — never commit
# real keys. (`make keys` will create `.env` from this template for you.)
#
# NOTE: this is the *voice repo's* .env. The bundled observability stack has its
# own separate credentials file at observability/.env.example.

# --- LLM / agent brain (thelab) ---------------------------------------------

# xAI Grok API key. Required when LLM_PROVIDER=xai (the default).
XAI_API_KEY=

# Supermemory API key, used by thelab for long-term memory recall.
# Leave blank to run without persistent memory.
SUPERMEMORY_API_KEY=

# Which brain to drive:
#   xai                -> hosted xAI Grok (needs XAI_API_KEY)
#   openai_compatible  -> any OpenAI-compatible endpoint, e.g. local Ollama
LLM_PROVIDER=xai

# Model name for the chosen provider.
#   xai example:               grok-3-mini
#   openai_compatible example: qwen2.5:32b (served by Ollama)
LLM_MODEL=grok-3-mini

# Model used by `make ollama` (LLM_PROVIDER is forced to openai_compatible and
# LLM_BASE_URL to http://localhost:11434/v1 by that target).
OLLAMA_MODEL=qwen2.5:32b

# --- Observability (optional) -----------------------------------------------

# Set to ship *content-free* per-turn latency metrics to any OTLP/HTTP
# collector (e.g. an OpenTelemetry Collector, or the bundled observability/
# stack). Base URL only; "/v1/metrics" is appended automatically. Leave unset
# to disable metrics export entirely (it is strictly opt-in).
#   example: VOICE_OTEL_ENDPOINT=http://collector-host:4318
# VOICE_OTEL_ENDPOINT=
