# Observability stack credentials
#
# Copy to `.env` in this directory (observability/.env) and set your own values.
# docker compose reads this file automatically. The real .env is gitignored.
#
#   cp .env.example .env
#   # edit .env, then:
#   docker compose up -d

# Password for the Postgres "voice" user (also used by the ingest service
# DATABASE_URL and the provisioned Grafana Postgres datasource).
POSTGRES_PASSWORD=changeme

# Grafana admin (login: admin) password.
GRAFANA_ADMIN_PASSWORD=changeme
